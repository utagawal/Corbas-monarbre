# Copier en .env et compléter. Ne jamais versionner .env.
# Laisser vide : une clé aléatoire est créée et conservée dans le volume de données (/data/secret.key)
SECRET_KEY=
ADMIN_EMAIL=agent@corbas.example
# Premier démarrage seulement. Laissé vide, un mot de passe est généré et affiché dans les journaux (docker compose logs app)
ADMIN_PASSWORD=choisir-un-mot-de-passe-solide
HTTPS=1
# 1 = charge des données d'EXEMPLE au premier démarrage (à laisser à 0 en production)
DEMO=0
# Domaines autorisés à intégrer le formulaire en iframe
FRAME_ANCESTORS=self https://corbas.fr https://www.corbas.fr https://ville-corbas.fr https://www.ville-corbas.fr
# Nombre maximal de demandes enregistrées par heure et par adresse IP
RATE_LIMIT=10
# Saisie assistée des adresses (1 = activée). Services : Base Adresse Nationale (familles) et Photon (stock d'arbres)
AUTOCOMPLETION=1
MAIRIE_NOM=Ville de Corbas
MAIRIE_ADRESSE=Place de la mairie, 69960 Corbas
MAIRIE_HORAIRES=du lundi au vendredi, horaires à compléter
MAIRIE_CONTACT=contact@corbas.example
MAIRIE_MAIRE=Benoit Eraclas
# Site de la ville (lien du logo). Le logo est livré avec l'application ; pour le remplacer : logo.png ou logo.jpg dans le volume /data, ou un chemin dans MAIRIE_LOGO
MAIRIE_SITE=https://corbas.fr
MAIRIE_DPO=dpo@corbas.example
# Adresses prévenues à chaque nouvelle demande (plusieurs, séparées par des virgules). Réglable aussi dans le back-office (menu Notifications), qui l'emporte.
# Vide : tous les comptes du back-office.
NOTIFICATION_EMAILS=accueil@corbas.example,enfance@corbas.example
# Application servie sous un sous-chemin d'un domaine partagé, par exemple /monarbre pour https://maps.utagawavtt.com/monarbre/
# Le serveur web doit retirer ce préfixe avant de transmettre la requête (voir le README). Vide : à la racine du domaine.
URL_PREFIX=
# Adresse publique de l'application, sans le sous-chemin (facultatif) : sert aux liens des e-mails envoyés aux agents
APP_URL=
# Envoi des e-mails (sans SMTP_HOST, ils sont seulement enregistrés dans le back-office)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ne-pas-repondre@corbas.example
